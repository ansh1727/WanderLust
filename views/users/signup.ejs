<% layout ("/layouts/boilerplate"); -%>

<div class="row mt-3">
    <h1 class="col-5 offset-4">SignUp on WanderLust</h1>
    <div>
        <form acton="/signup" method="post" class="needs-validation" novalidate>
            <div class="mb-3 col-5 offset-3">
                <label for="username" class="form-label" >Username</label>
                <input name="username" id="username" type="text"class="form-control" required>
                <div class="valid-feedback">username looks good!</div>
            </div>

            <div class="mb-3 col-5 offset-3">
                <label for="email" class="form-label" >Email</label>
                <input name="email" id="email" type="text"class="form-control" required>
            </div>


            <div class="mb-3 col-5 offset-3">
                <label for="password" class="form-label" >Password</label>
                <input name="password" id="password" type="password"class="form-control" required>
            </div>
            <button class="btn btn-success offset-5">SignUp</button>
        </form>
    </div>
</div>