<% layout ("/layouts/boilerplate"); -%>
<section class="showcase-layout">
  <div class="showcase-main">
    <div class="showcase-header">
      <p class="section-kicker">Featured stay</p>
      <h1><%=listing.title %></h1>
      <p class="showcase-meta">Hosted by <b><%= listing.owner.username %></b> in <%= listing.location %>, <%= listing.country %></p>
    </div>

    <div class="card show-card listing-card">
        <img src="<%=listing.image.url%>" class="card-img-top show-img" alt="Listing_image">
        <div class="card-body show-card-body">
          <p class="show-description"><%=listing.description %></p>
          <div class="show-highlights">
            <div class="highlight-pill"><i class="fa-solid fa-location-dot"></i><span><%= listing.location%>, <%= listing.country%></span></div>
            <div class="highlight-pill"><i class="fa-solid fa-indian-rupee-sign"></i><span>₹<%=listing.price.toLocaleString("en-IN") %> per night</span></div>
          </div>
        </div>
    </div>

    <div
      id="show-map"
      class="map-container"
      data-location="<%= listing.location %>, <%= listing.country %>"
    ></div>

    <% if(curruser && curruser._id.equals(listing.owner._id)){%>
    <div class="btns owner-actions">
        <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark edit-btn">Edit Listing</a>
        <form method="post" action="/listings/<%=listing._id%>?_method=DELETE">
          <button class="btn btn-outline-dark">Delete</button>
        </form>
    </div>
    <% } %>
  </div>

  <aside class="showcase-sidebar">
<% if(curruser) { %>
<div class="review-panel mb-4">
    <h4>Leave a Rating</h4>
    <form method="post" action="/listings/<%=listing._id%>/reviews" novalidate class="needs-validation">
        <div class="mb-3 mt-2">
            <label for="rating" class="form-label mb-3 mt-2">Rating</label>
        <fieldset class="starability-checkmark">
            <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
            <input type="radio" id="first-rate1" name="review[rating]" value="1" />
            <label for="first-rate1" title="Terrible">1 star</label>
            <input type="radio" id="first-rate2" name="review[rating]" value="2" />
            <label for="first-rate2" title="Not good">2 stars</label>
            <input type="radio" id="first-rate3" name="review[rating]" value="3" />
            <label for="first-rate3" title="Average">3 stars</label>
            <input type="radio" id="first-rate4" name="review[rating]" value="4" />
            <label for="first-rate4" title="Very good">4 stars</label>
            <input type="radio" id="first-rate5" name="review[rating]" value="5" />
            <label for="first-rate5" title="Amazing">5 stars</label>
          </fieldset>
          </div>


        <div>
            <label for="comment"class="form-label">Comment</label>
            <textarea class="form-control" name="review[comment]" id="comment"cols="30" rows="5" required></textarea>
            <div class="invalid-feedback">Please add some comments</div>
        </div>
        <div><button class="btn btn-outline-dark mb-3 mt-3">Submit Review</button></div>
</form>
</div>
<% } %>

<div class="review-panel">
<h4>All Reviews</h4>
<div class="row g-3">
    <% for(let review of listing.reviews){ %>
        <div class="col-12">
          <div class="card review-card">
            <div class="card-body">
                <h5 class="card-title">@<%= review.owner.username %></h5>
                <p class="card-text"><%= review.comment %></p>
                <p class="starability-result card-text" data-rating="<%=review.rating%>">
                </p>
            </div>
            <form class="mb-3 review-delete" method="post" action="/listings/<%=listing._id%>/reviews/<%=review._id%>?_method=DELETE"><button class="btn btn-sm btn-dark">Delete</button></form>
          </div>
        </div>
    <% } %>
</div>
</div>
  </aside>
</section>
