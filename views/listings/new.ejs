<% layout ("/layouts/boilerplate"); -%>
    <div class="col-8 offset-2">
    <h2>Create a new Listing</h2>
    
    <div class="row">
        
    <form method="post" action="/listings" novalidate class="needs-validation" enctype="multipart/form-data">
        <div class="mb-3">
            <label for="title" class="form-label" >Enter Title</label>
            <input name="listing[title]" type="text" placeholder="enter title" class="form-control" required>
            <div class="valid-feedback">Title looks good!</div>
        </div>
        
        

        <div class="mb-3">
            <label for="description" class="form-label">Description</label>
            <textarea name="listing[description]" class="form-control" required></textarea>
            <div class="invalid-feedback">Please Enter Description</div>
        </div>


        <div class="mb-3">
            <label for="image" class="form-label">upload Photo</label>
            <input name="listing[image][url]" type="file" class="form-control">
            required
        </div>


        <div class="row">
            <div class="mb-3 col-4">
                <label for="price" class="form-label">Price</label>
                <input name="listing[price]" type="number" placeholder="1200" class="form-control" required>
                <div class="invalid-feedback">Please Enter Valid Price</div>
            </div>
    
            <div class="mb-3 col-md-8">
                <label for="country" class="form-label">Country</label>
                <input name="listing[country]" placeholder="India"class="form-control" required >
                <div class="invalid-feedback">Please Enter Country Name</div>
            </div>
        </div>


        <div class="mb-3">
            <label for="location" class="form-label">location</label>
            <input name="listing[location]" id="listing-location-input" placeholder="jaipur,rajisthan,delhi,gurgaon"class="form-control" required>
            <div class="invalid-feedback">Please Enter Location</div>
        </div>
        <div id="location-map" class="map-container"></div>
        <small id="location-coords" class="text-muted"></small>
        <br><br>
        <button class="btn btn-dark add-btn">Add</button>
    </form>
</div>
</div>